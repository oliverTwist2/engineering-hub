# ============================================================
# Engineering Intelligence Hub — Environment Variables
# ============================================================
# Copy this file to ".env" and fill in your values:
#   cp .env.example .env
#
# Lines starting with # are comments and are ignored.
# ============================================================


# ------------------------------------------------------------
# REQUIRED
# ------------------------------------------------------------

# Your Anthropic API key — get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Secret key used to authenticate requests to this Hub's API.
# Choose any string. Include it in requests as the X-API-Key header.
API_KEY=your-hub-api-key


# ------------------------------------------------------------
# DATABASE & STORAGE
# ------------------------------------------------------------

# Vector database backend. Options: "chroma" (local, default) or "pgvector" (PostgreSQL).
VECTOR_BACKEND=chroma

# SQLite database URL for evaluation logs.
DATABASE_URL=sqlite:///hub.db


# ------------------------------------------------------------
# INGESTION SETTINGS
# ------------------------------------------------------------

# Number of files processed per batch during ingestion.
INGEST_BATCH_SIZE=10

# Maximum number of tokens per text chunk when splitting documents.
CHUNK_SIZE=512

# Number of tokens of overlap between consecutive chunks.
# Overlap helps preserve context across chunk boundaries.
CHUNK_OVERLAP=64


# ------------------------------------------------------------
# MODEL ASSIGNMENTS
# Specify which Anthropic Claude model each component uses.
# See available models at https://docs.anthropic.com/en/docs/about-claude/models
# ------------------------------------------------------------

# Orchestrator agent — handles the main RAG pipeline and retries.
MODEL_ORCHESTRATOR=claude-3-opus-20240229

# Ingestor — generates embeddings and processes file content.
MODEL_INGESTOR=claude-3-5-haiku-20241022

# Retriever — synthesises answers from retrieved chunks.
MODEL_RETRIEVER=claude-3-5-sonnet-20241022

# Test writer — used for automated test generation tasks.
MODEL_TEST_WRITER=claude-3-5-haiku-20241022

# Code writer — used for code generation tasks.
MODEL_CODE_WRITER=claude-3-5-haiku-20241022
